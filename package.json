{
    "name": "token-count-api",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "concertypin",
        "url": "https://github.com/concertypin"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/concertypin/token-count-api"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "node --env-file=.env --watch --experimental-strip-types src/server.ts",
        "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --alias:@=./src --packages=external",
        "start": "node --env-file=.env dist/server.js",
        "cf-typegen": "wrangler types --env-interface CloudflareBindings",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "pnpm run lint:oxlint --fix",
        "lint:check": "pnpm run lint:oxlint",
        "lint:oxlint": "oxlint -c oxlint.config.ts . --type-aware --type-check --report-unused-disable-directives-severity=error",
        "postinstall": "pnpm run cf-typegen && simple-git-hooks",
        "check": "pnpm run format && pnpm run lint && pnpm run test",
        "test": "vitest run",
        "deploy": "pnpm run build && wrangler deploy",
        "heroku-postbuild": "pnpm run build"
    },
    "engines": {
        "node": ">=26"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.0",
        "@hono/standard-validator": "^0.3.0",
        "@lenml/tokenizer-gemini": "^3.7.2",
        "@scalar/hono-api-reference": "^0.11.12",
        "gpt-tokenizer": "^3.4.0",
        "hono": "^4.13.5",
        "hono-openapi": "^1.3.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.50.0",
        "@cloudflare/vitest-pool-workers": "^0.20.1",
        "@concertypin/config": ">=0.3.0 <1.0.0",
        "@types/node": "^26.1.2",
        "@vitest/coverage-istanbul": "^4.1.10",
        "cross-env": "^10.1.0",
        "esbuild": "^0.28.1",
        "globals": "^17.9.0",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "^7.0.2001",
        "simple-git-hooks": "^2.13.1",
        "typescript": "~7.0.2",
        "vite": "^8.2.0",
        "vitest": "^4.1.10",
        "wrangler": "^4.118.0"
    },
    "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a",
    "description": "Count tokens across DeepSeek V4, GLM 5.2, Kimi K3, Gemini, GPT-5, Claude"
}
